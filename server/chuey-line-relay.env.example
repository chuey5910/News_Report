# คัดลอกเป็น /etc/chuey-line-relay.env แล้วเติมค่าจริง (chmod 600 กันคนอื่นอ่าน)

# จาก LINE Developers Console -> channel ของ OA "KhuFah" -> Basic settings
LINE_CHANNEL_SECRET=

# จาก LINE Developers Console -> Messaging API -> Channel access token (long-lived)
# ต้องเป็น token ตัวเดียวกับที่ตั้งใน GitHub secret LINE_CHANNEL_ACCESS_TOKEN
LINE_CHANNEL_ACCESS_TOKEN=

# รหัสลับที่คุณตั้งเอง (สุ่มยาวๆ) ใช้ยืนยันว่า /notify ถูกเรียกจาก pipeline จริง
# ต้องเป็นค่าเดียวกับ GitHub secret CHUEY_SERVER_TOKEN
CHUEY_SERVER_TOKEN=

# ที่เก็บรายการ groupId (ค่าเริ่มต้น groups.json ใน WorkingDirectory)
GROUPS_STORE_PATH=/opt/chuey-line-relay/groups.json

# พอร์ตที่บริการฟัง (ให้ reverse proxy/HTTPS ชี้มาที่นี่)
PORT=8080
